{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dgrassi1984/agent-workflows/overlay.schema.json",
  "title": "Agent workflow project overlay",
  "description": "Bindings a project supplies to the repo-independent workflows. Steps never appear here; see references/project-overlay.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema"],
  "properties": {
    "schema": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "conventions": { "type": "string", "description": "repo-relative path to the invariants doc" },
        "codemap": { "type": "string" },
        "primary_checkout": { "enum": ["read-only", "writable"], "default": "read-only" }
      }
    },
    "forge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["github", "gitlab"] },
        "repo": { "type": "string", "pattern": "^[^/]+/.+$" },
        "default_branch": { "type": "string", "default": "main" },
        "branch_prefixes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "issues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved_label": { "type": "string" },
        "block_labels": { "type": "array", "items": { "type": "string" } },
        "claim_label": { "type": ["string", "null"] },
        "severity_labels": { "type": "array", "items": { "type": "string" } },
        "never_set": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gate": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "gate_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verify",
        "release",
        "documentation"
      ],
      "properties": {
        "verify": {
          "type": "string",
          "minLength": 1,
          "description": "Read-only command verifying applicable trusted evidence for the current candidate; nonzero requires gate execution."
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "description": "Validate the final version-bearing tree and release artifacts; may reuse applicable evidence."
        },
        "documentation": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative evidence validity and provenance contract."
        }
      }
    },
    "gate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast_every",
        "full_every",
        "budgets_seconds",
        "commands",
        "timeout"
      ],
      "properties": {
        "fast_every": {
          "type": "integer",
          "minimum": 1
        },
        "full_every": {
          "type": "integer",
          "minimum": 1
        },
        "budgets_seconds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "focused",
            "fast",
            "full"
          ],
          "properties": {
            "focused": {
              "type": "integer",
              "minimum": 1
            },
            "fast": {
              "type": "integer",
              "minimum": 1
            },
            "full": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fast",
            "full"
          ],
          "properties": {
            "fast": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "full": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "timeout": {
          "enum": [
            "block",
            "waive"
          ],
          "default": "block"
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string" },
        "provision": { "type": "string" }
      }
    },
    "ship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "authorization": { "enum": ["pre-authorized", "ask"], "default": "ask" },
        "after_merge": { "type": "boolean", "default": false },
        "release_cadence": { "enum": ["per-batch", "checkpoint", "manual"], "default": "per-batch" },
        "release_every": { "type": "integer", "minimum": 1 },
        "procedure": { "type": "string", "description": "repo-relative deploy/verify document; optional once versioning defaults apply" },
        "versioning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scheme": { "enum": ["semver", "none"], "default": "semver" },
            "bump": { "enum": ["infer", "patch", "ask"], "default": "infer" },
            "files": { "type": "array", "items": { "type": "string" }, "description": "repo-relative paths that must all receive the new version; empty means auto-detect" },
            "changelog": { "type": "string", "description": "repo-relative path, or 'none'; unset means auto-detect" },
            "tag": { "type": "string", "default": "v{version}" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "release_cadence": { "const": "checkpoint" } }, "required": ["release_cadence"] },
          "then": { "required": ["release_every"] }
        },
        {
          "if": { "properties": { "after_merge": { "const": true } }, "required": ["after_merge"] },
          "then": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"],
            "description": "after_merge without shipping is incoherent — land-prs would hand off to a release that must stop"
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "failure_classes": { "type": "string" } }
    },
    "docs_move_with_code": { "type": "array", "items": { "type": "string" } }
  }
}
